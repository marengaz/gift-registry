        "entries_allocation_consistent": {
          "name": "entries_allocation_consistent",
          "value": "(\n    \"entries\".\"state\" = 'available' AND \"entries\".\"buyer_id\" IS NULL AND \"entries\".\"allocation_source\" IS NULL AND \"entries\".\"allocated_by_id\" IS NULL AND \"entries\".\"actual_pence\" IS NULL\n  ) OR (\n    \"entries\".\"state\" IN ('allocated', 'purchased') AND \"entries\".\"buyer_id\" IS NOT NULL AND \"entries\".\"allocated_by_id\" IS NOT NULL AND \"entries\".\"allocation_source\" IS NOT NULL AND \"entries\".\"allocation_source\" IN ('self', 'administrator') AND (\"entries\".\"state\" = 'purchased' OR \"entries\".\"actual_pence\" IS NULL)\n  )"
        }
