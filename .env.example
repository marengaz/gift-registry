# Local development uses http://localhost:5173. Home deployment uses its exact HTTPS origin.
ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Configure exactly one administrator identity. A verified email binds its Google subject on first sign-in.
ADMINISTRATOR_EMAIL=
ADMINISTRATOR_GOOGLE_SUBJECT=

# Local Node development paths. Compose supplies its own paths inside the persistent volume.
DATABASE_PATH=./data/gifts.sqlite
MEDIA_PATH=./data/media
BODY_SIZE_LIMIT=64M

# Optional prebuilt image for compose.release.yaml (Linux AMD64). Pin a released version.
GIFT_IMAGE=ghcr.io/marengaz/gift-registry:0.1.0

# Home deployment: replace these examples and set ORIGIN=https://YOUR_HOSTNAME.
PUBLIC_HOSTNAME=gifts.example.com
ACME_EMAIL=

# Optional personal Vision setup. Leave blank to use capture and retailer metadata without paid matching.
VISION_PROJECT_ID=
VISION_CREDENTIALS_FILE=
VISION_CREDENTIALS_DIRECTORY=./secrets

# Optional photo-to-shop search using SerpAPI Google Lens. Key: https://serpapi.com/manage-api-key
# Enable identification in the app too. This counts this app's searches per UTC calendar month,
# independently of the provider's account-wide allowance and renewal date.
SERPAPI_API_KEY=
SERPAPI_MONTHLY_SEARCH_LIMIT=200

# Optional Gemini extraction fallback. Existing retailer metadata remains the first pass.
# The API key selects its personal Google project; the machine's gcloud default is not used.
# Enable AI in administrator identification settings after configuring the key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MONTHLY_BUDGET_USD=2.00
# Evaluations also count towards the monthly allowance above.
GEMINI_EVAL_BUDGET_USD=0.25
