{
	"name": "family-gift-catalogue",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build && vite build --config vite.worker.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check src tests scripts *.ts *.json README.md docs/deployment.md docs/backup-restore.md docs/android-acceptance.md compose.yaml compose.release.yaml Caddyfile Dockerfile .env.example .github/workflows docs/releases.md --ignore-unknown",
		"test:unit": "vitest run tests/unit --passWithNoTests",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "playwright test",
		"db:migrate": "tsx src/lib/server/db/migrate.ts",
		"worker": "node --env-file-if-exists=.env build-worker/worker.js",
		"verify": "npm run check && npm run lint && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e",
		"backup": "node --env-file-if-exists=.env scripts/backup.mjs",
		"start": "node --env-file-if-exists=.env scripts/start.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.6.6",
		"drizzle-kit": "0.31.11",
		"fake-indexeddb": "6.2.7",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.15",
		"better-auth": "1.7.15",
		"better-sqlite3": "13.0.3",
		"cheerio": "1.2.0",
		"dexie": "4.4.7",
		"drizzle-orm": "0.45.4",
		"google-auth-library": "11.3.3",
		"ipaddr.js": "2.5.0",
		"sharp": "0.35.5",
		"zod": "4.6.7"
	},
	"engines": {
		"node": ">=26.13.0 <27"
	},
	"license": "MIT"
}
